# Server-only, comma-separated mainnet RPC failover list. Put a dedicated
# provider first in production. Never expose API keys through a VITE_ variable.
SOLANA_RPC_URLS=https://your-mainnet-provider.example,https://api.mainnet-beta.solana.com

# Local-development fallback only. Production uses the same-origin
# /api/solana-rpc gateway unless VITE_SOLANA_BROWSER_RPC_URL is deliberately set.
VITE_SOLANA_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com

# Optional browser-safe dedicated endpoint. Avoid URLs containing API keys.
# VITE_SOLANA_BROWSER_RPC_URL=
